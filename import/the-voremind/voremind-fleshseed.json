    {
      "_id": "CoLMEyVaLr6SR6lu",
      "name": "Parasitic Latch",
      "type": "attack",
      "img": "systems/pf1/icons/items/inventory/monster-head.jpg",
      "effects": [],
      "folder": null,
      "sort": 50000,
      "flags": {
